# .env.example
# MongoDB Database connection URI
MONGO_URI=mongodb://localhost:27017/futurelegacy

# Razorpay API Credentials (required to accept live cards/netbanking/UPI payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Stripe API Credentials (required for international card payments)
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# Cashfree API Credentials (optional for Indian gateway fallback)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Direct Merchant UPI ID (for instant QR / UPI app intent payments)
MERCHANT_UPI_ID=shourya@upi

# Gemini API key (Required for AI features, like AgriBot AI)
GEMINI_API_KEY=
